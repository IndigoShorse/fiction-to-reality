---
import ResearchLayout from '../../layouts/ResearchLayout.astro';
import MarkdownArticle from '../../components/Lib/MarkdownArticle.astro';
import { getArticleBySlug } from '../../data/lib';
import { pageConfigs } from '../../config/pages';
import '../../styles/lib/blog.css';

const article = await getArticleBySlug('dvoe-menya');
if (!article) throw new Error('Article not found: dvoe-menya');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<ResearchLayout pageTitle={`${article.title} — Библиотека`} version={pageConfigs.lib.version} activePage="lib">
  <article class="blog-article">
    <a class="back" href={`${base}lib/`}>← Библиотека</a>
    <h1>{article.title}</h1>
    <MarkdownArticle markdown={article.markdown} />
  </article>
</ResearchLayout>
