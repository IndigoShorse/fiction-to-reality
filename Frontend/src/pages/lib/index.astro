---
import ResearchLayout from '../../layouts/ResearchLayout.astro';
import { pageConfigs } from '../../config/pages';
import ArticleCard from '../../components/Lib/ArticleCard.astro';
import { listArticles } from '../../data/lib';
import '../../styles/lib/blog.css';

const articles = await listArticles();
---

<ResearchLayout pageTitle="Библиотека — Gap Research Lab" version={pageConfigs.lib.version} activePage="lib">
  <main class="library-page">
    <h1>Библиотека</h1>
    <p class="lead">Тексты и материалы проекта.</p>
    {articles.map((article) => <ArticleCard article={article} />)}
  </main>
</ResearchLayout>
